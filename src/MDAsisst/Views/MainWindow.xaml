<Window x:Class="MDAsisst.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="MDAsisst - Markdownアシスタント" Height="600" Width="900"
        AllowsTransparency="True" WindowStyle="None" Background="#881E1E1E"
        Topmost="True" MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Title bar & Controls -->
        <DockPanel Grid.Row="0" Background="#22FFFFFF" LastChildFill="False">
            <TextBlock Text="MDAsisst (半透明モード)" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <Button Content="✕" DockPanel.Dock="Right" Width="30" Height="25" Click="CloseButton_Click" Background="Transparent" Foreground="White" BorderBrush="Transparent"/>
            <Button Content="🗕" DockPanel.Dock="Right" Width="30" Height="25" Click="MinimizeButton_Click" Background="Transparent" Foreground="White" BorderBrush="Transparent"/>
            <Button Content="⚙" DockPanel.Dock="Right" Width="30" Height="25" Click="SettingsButton_Click" Background="Transparent" Foreground="White" BorderBrush="Transparent"/>
        </DockPanel>

        <!-- Main Content: Editor & Preview & CheatSheet -->
        <Grid Grid.Row="1" Margin="0,5,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- Editor -->
            <TextBox x:Name="MarkdownEditor" Grid.Column="0" AcceptsReturn="True" TextWrapping="Wrap"
                     Background="#44000000" Foreground="White" BorderBrush="#66FFFFFF" Padding="10"
                     TextChanged="MarkdownEditor_TextChanged"
                     PlaceholderText="ここにMarkdownを入力..."/>

            <!-- Preview / Effect -->
            <WebBrowser x:Name="PreviewBrowser" Grid.Column="1" Margin="5,0,0,0"/>

            <!-- Cheat Sheet & Snippets -->
            <Border Grid.Column="2" Background="#44222222" BorderBrush="#66FFFFFF" BorderThickness="1" Margin="5,0,0,0" Padding="5">
                <StackPanel>
                    <TextBlock Text="Markdownチートシート" Foreground="Yellow" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Button Content="# 見出し 1" Click="SnippetButton_Click" Tag="# " Margin="2"/>
                    <Button Content="## 見出し 2" Click="SnippetButton_Click" Tag="## " Margin="2"/>
                    <Button Content="**太字**" Click="SnippetButton_Click" Tag="**太字**" Margin="2"/>
                    <Button Content="- リスト" Click="SnippetButton_Click" Tag="- " Margin="2"/>
                    <Button Content="[リンク](url)" Click="SnippetButton_Click" Tag="[タイトル](URL)" Margin="2"/>
                    <Button Content="```コード```" Click="SnippetButton_Click" Tag="```csharp
// code
```" Margin="2"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="Transparent" Foreground="White">
            <StatusBarItem Content="状態: 稼働中 (オフライン対応) | トレイ常駐対応"/>
        </StatusBar>
    </Grid>
</Window>
