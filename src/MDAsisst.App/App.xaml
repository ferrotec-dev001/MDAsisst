<Application x:Class="MDAsisst.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!-- Issue #16: WPF Fluent デザインの共通トークン・スタイルを一元管理する。
         MainWindow/SettingsWindow はここから TitleIconButton 等を参照し、
         個別定義（Issue #10 時点の重複）を廃止した。 -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/FluentTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
