<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MDAsisst</AssemblyName>
    <RootNamespace>MDAsisst.App</RootNamespace>
    <!-- Velopack: 自動生成 Main を無効化し App.Main を使う (ADR-0003) -->
    <StartupObject>MDAsisst.App.App</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MDAsisst.Core\MDAsisst.Core.csproj" />
    <ProjectReference Include="..\MDAsisst.Rendering\MDAsisst.Rendering.csproj" />
    <ProjectReference Include="..\MDAsisst.Updating\MDAsisst.Updating.csproj" />
  </ItemGroup>
</Project>
